# Build from the repo root: the example depends on packages/client-js via file:.
FROM node:22-alpine

RUN corepack enable
WORKDIR /repo
COPY packages/client-js packages/client-js
COPY examples/nextjs-blog examples/nextjs-blog

WORKDIR /repo/examples/nextjs-blog
RUN pnpm install --no-frozen-lockfile && pnpm build

EXPOSE 3002
CMD ["pnpm", "start"]
